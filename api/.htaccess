# =============================================================================
# iWE API - Apache / LiteSpeed Rewrite Rules (Hostinger Native)
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Reject private storage before existing-file passthrough.
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^(?:config|core|migrations|scripts|storage)(?:/|$) - [F,L,NC]
    RewriteRule \.(?:sql|sqlite3?|db|log|ini|env|bak|old|orig|save|swp|lock|map)(?:/|$) - [F,L,NC]
    RewriteRule ^(?!index\.php$).*\.(?:php[0-9]?|phtml|phar)(?:/|$) - [F,L,NC]
    RewriteCond %{REQUEST_URI} !\.(?:jpe?g|png|webp|gif|avif|mp4|webm)$ [NC]
    RewriteRule ^uploads/ - [F,L,NC]

    # Use the shared realpath/extension boundary even when Apache applies
    # this nested ruleset instead of the document-root rewrite rules.
    RewriteRule ^uploads/ ../index.php [END]

    # All remaining API paths, including physical controller directories,
    # are handled by the API entry point rather than served as files.
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [F,L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent directory listings
Options -Indexes
