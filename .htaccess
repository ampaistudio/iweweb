# =============================================================================
# iWE Web - Apache / LiteSpeed Rewrite Rules (Hostinger Native)
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Private project material must never reach existing-file passthrough.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule ^(?:src|tests|scripts|node_modules|content|dist|graphify-out)(?:/|$) - [F,L,NC]
    RewriteRule ^api/(?:config|core|migrations|scripts|storage)(?:/|$) - [F,L,NC]
    RewriteRule \.(?:sql|sqlite3?|db|log|ini|env|bak|old|orig|save|swp|lock|map|ts|tsx|py|sh)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:package(?:-lock)?\.json|composer\.(?:json|lock)|tsconfig\.json)$ - [F,L,NC]
    RewriteCond %{REQUEST_URI} !^/(?:api/)?index\.php$
    RewriteRule \.(?:php[0-9]?|phtml|phar)(?:/|$) - [F,L,NC]
    RewriteCond %{REQUEST_URI} !\.(?:jpe?g|png|webp|gif|avif|mp4|webm)$ [NC]
    RewriteRule ^api/uploads/ - [F,L,NC]
    RewriteCond %{REQUEST_URI} !\.(?:js|mjs|css|svg|jpe?g|png|webp|gif|avif|ico|woff2?|ttf|mp4|webm)$ [NC]
    RewriteRule ^assets/ - [F,L,NC]

    # 1. Prerender for Social Crawlers & AI Search Bots — Tour detail pages (/tour/:id)
    # Matches: Facebook, WhatsApp, Twitter/X, Telegram, LinkedIn, Slack, Pinterest,
    # as well as Generative AI bots: GPTBot, Google-Extended, PerplexityBot, ClaudeBot, CCBot, etc.
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Pinterest|SkypeUriPreview|Google-Extended|GPTBot|PerplexityBot|ClaudeBot|anthropic-ai|CCBot) [NC]
    RewriteRule ^tour/([a-zA-Z0-9_-]+)/?$ api/index.php?seo_prerender=$1 [QSA,L]

    # 2. Prerender for Social Crawlers & AI Search Bots — Article detail pages (/novedades/:slug)
    # Same User-Agent list as rule 1; only matches slugged articles, NOT the bare /novedades listing.
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Pinterest|SkypeUriPreview|Google-Extended|GPTBot|PerplexityBot|ClaudeBot|anthropic-ai|CCBot) [NC]
    RewriteRule ^novedades/([a-zA-Z0-9_-]+)/?$ api/index.php?seo_prerender_post=$1 [QSA,L]

    # 3. Dynamic XML Sitemap (queried live from database for search engines & AI bots)
    RewriteRule ^sitemap\.xml$ api/index.php?sitemap=1 [L]

    # 4. Block direct access to physical admin-panel folder (Security by Design - NAES §9)
    RewriteRule ^admin-panel(/.*)?$ - [F,L]

    # Resolve public file paths in PHP as well, rejecting symlink escapes.
    RewriteRule ^(?:assets|api/uploads)/ index.php [L]

    # Only entry points and explicit root public files bypass the controller.
    RewriteRule ^(?:index\.php|index\.html|robots\.txt|favicon\.ico|api/index\.php)$ - [L]
    RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [L]
    RewriteRule ^api(?:/|$) api/index.php [QSA,L]

    # 6. Front Controller: Route dynamic requests (secret panel slug & SPA fallback) to index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent directory listings
Options -Indexes
